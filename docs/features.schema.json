{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slovakian/opul/blob/main/docs/features.schema.json",
  "title": "Opul feature tracker file",
  "description": "One category file under docs/features/. The directory is the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "source",
        "status",
        "priority",
        "summary",
        "notes",
        "reason",
        "issue",
        "added",
        "updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable kebab-case identifier."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "enum": [
            "torrent",
            "media-download",
            "direct-download",
            "organization",
            "ui",
            "system",
            "other"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^(?:qbittorrent|yt-dlp|opul-original|user-request|competitor:[a-z0-9]+(?:-[a-z0-9]+)*)$"
        },
        "status": {
          "enum": [
            "idea",
            "planned",
            "in-progress",
            "shipped",
            "partial",
            "wont-do"
          ]
        },
        "priority": {
          "anyOf": [
            {
              "enum": ["p0", "p1", "p2", "p3"]
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 320,
          "description": "One or two user-facing sentences."
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            {
              "type": "null"
            }
          ]
        },
        "issue": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "added": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "wont-do"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["reason"]
          }
        }
      ]
    }
  }
}
