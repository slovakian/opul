# Pinned sources for the tools bundled in Opul.app/Contents/Helpers.
# Scripts/build_media_tools.sh downloads each tarball and refuses one whose SHA-256 differs.
# To bump a tool, change its version, URL and checksum here, run the Media Tools workflow,
# then commit the new MediaTools/release.env it prints. See docs/releasing.md.

FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# Bellard's QuickJS. yt-dlp warns that releases before 2025-04-26 solve challenges slowly.
QUICKJS_VERSION=2026-06-04
QUICKJS_URL=https://bellard.org/quickjs/quickjs-2026-06-04.tar.xz
QUICKJS_SHA256=b376e839b322978313d929fd20663b11ba58b75df5a46c126dd19ea2fa70ad2a
