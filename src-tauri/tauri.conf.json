{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opul",
  "mainBinaryName": "Opul",
  "version": "0.1.0",
  "identifier": "dev.opul.app",
  "build": {
    "beforeDevCommand": "Scripts/build_icon.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "Scripts/build_icon.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Opul",
        "width": 1220,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 19 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "public.app-category.utilities",
    "shortDescription": "A quiet home for your downloads.",
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
