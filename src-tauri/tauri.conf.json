{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opul",
  "mainBinaryName": "Opul",
  "version": "0.1.0",
  "identifier": "dev.opul.app",
  "build": {
    "beforeDevCommand": "Scripts/fetch_ffmpeg.sh && Scripts/build_icon.sh && vp run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "Scripts/fetch_ffmpeg.sh && Scripts/build_icon.sh && vp run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Opul",
        "width": 1220,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "public.app-category.utilities",
    "shortDescription": "A quiet home for your downloads.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "bundleName": "Opul"
    },
    "resources": {
      "resources/media-tools/": "media-tools/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/slovakian/opul/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMDUwRDVFQkZFRTJFNEUKUldST0x1Ni9YZzBGL2RaUy9mSVNTUW5YRzNYVCtRVEF0bHRsYnJUM01FVDU2bFBYT3BZd25YSTIK"
    }
  }
}
